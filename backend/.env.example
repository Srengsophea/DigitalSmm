# DigitalSMM Backend Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_jwt_strong_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# AES-256-GCM Master Encryption Key (32-byte hex key)
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# SMMFollows Provider Configuration
SMMFOLLOWS_API_KEY=your_smmfollows_api_key_here
SMMFOLLOWS_API_URL=https://smmfollows.com/api/v2

# Business / Resale Settings
DEFAULT_MARKUP_PERCENT=30

# Initial Admin Credentials
ADMIN_EMAIL=admin@digitalsmm.com
ADMIN_PASSWORD=Admin@DigitalSMM2026!

# CORS Whitelist (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
